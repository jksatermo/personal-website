{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "A personal portfolio built with MongoDB, Express, React, and Node.js.",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --workspace client -- --host 0.0.0.0",
    "build": "npm run build --workspace client",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "setup:mongodb:docker": "node scripts/prepare-mongodb-docker.js",
    "test": "node --test server/test/*.test.js",
    "test:browser": "node scripts/test-browser.js"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  }
}
