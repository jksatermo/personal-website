# Optional for local development: `npm run dev` starts a persistent local MongoDB.
# Required for production; supply this securely through your hosting provider.
# MONGODB_URI=mongodb://127.0.0.1:27017/personal_website

# Express API port. The Vite development proxy uses this value too.
PORT=3001

# Production: build the React client, set NODE_ENV=production, then npm start.
# NODE_ENV=production
